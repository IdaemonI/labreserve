# Synthetic local demonstration only. Do not use these credentials in production.
POSTGRES_DB=labreserve
POSTGRES_USER=labreserve
POSTGRES_PASSWORD=labreserve_demo_only
HTTP_PORT=8080
SWAGGER_PORT=8081
SIMULATOR_MODE=normal
SIMULATOR_DELAY=3s
DATABASE_TIMEOUT=2s
DIAGNOSTICS_TIMEOUT=1s
HTTP_REQUEST_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s

# Host-only development: PostgreSQL must already be running at this address.
# Compose supplies its own internal DATABASE_URL and GRPC_TARGET.
DATABASE_URL=postgres://labreserve:labreserve_demo_only@127.0.0.1:5432/labreserve?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
GRPC_TARGET=127.0.0.1:9090
GRPC_ADDR=127.0.0.1:9090

# Separate, explicitly created educational test database; never use DATABASE_URL.
TEST_DATABASE_URL=postgres://labreserve:labreserve_demo_only@127.0.0.1:5432/labreserve_test?sslmode=disable
